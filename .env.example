# Copy to .env and choose a random secret. Never commit .env.
GATEWAY_TOKEN=replace-with-a-random-secret-at-least-32-characters
GATEWAY_MODE=MOCK
ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000,http://localhost:5173,http://127.0.0.1:5173
# MQTT mode requires a configured broker and actual telemetry publishers.
# MQTT_BROKER_URL=mqtts://broker.example:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
